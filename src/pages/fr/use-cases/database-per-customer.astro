const steps: Step[] = [
  { title: 'Écrire un fournisseur de clés',
    body: 'Barrel demande une clé au fournisseur à chaque ouverture de base, par son keyspace (l’identifiant de l’espace). Renvoyez exactement 32 octets. Une erreur fait échouer l’ouverture.',
    label: 'Erlang', lang: 'erlang',
    code: `-module(tenant_keys).
-behaviour(barrel_keyprovider).
-export([key_for_db/1]).

key_for_db(Keyspace) ->
    %% my_kms is your code: fetch or derive the key
    {ok, my_kms:data_key(Keyspace)}.` },
  { title: 'Créer un espace par client',
    body: 'Les documents, les pièces jointes du stockage par défaut, les vecteurs et les fichiers d’index sur disque sont chiffrés sous cette clé. Gardez l’identifiant renvoyé avec la fiche du client.',
    label: 'Erlang', lang: 'erlang',
    code: `{ok, _} = application:ensure_all_started(barrel_spaces),
Enc = #{provider => tenant_keys},
{ok, #{id := Acme, db := Db}} =
    barrel_spaces:create_space(#{label => <<"acme">>,
                                 encryption => Enc}),
{ok, _} = barrel:put_doc(Db, #{<<"id">> => <<"inv-1">>,
                               <<"total">> => 1200}).` },
  { title: 'Émettre des jetons pour les agents du client',
    body: 'Un droit est limité à un espace. barrel_server le vérifie à chaque requête ; votre code peut aussi le vérifier directement.',
    label: 'Erlang', lang: 'erlang',
    code: `{ok, Token, _Grant} = barrel_caps:grant(Acme,
    #{rights => [read, write],
      subject => <<"acme-support-bot">>}),
{ok, _} = barrel_caps:verify(Token, Acme, write).` },
  { title: 'Passer la spécification de clé à chaque ouverture',
    body: 'Le chiffrement est une configuration d’exécution. Sans la spécification, un espace chiffré ne s’ouvre pas ; avec une mauvaise clé, l’ouverture échoue sans rien exposer.',
    label: 'Erlang', lang: 'erlang',
    code: `{error, db_is_encrypted} =
    barrel_spaces:open_space(Acme),
{ok, Space} =
    barrel_spaces:open_space(Acme, #{encryption => Enc}).`,
    outLabel: 'D’après une exécution enregistrée',
    out: `open encrypted space without spec: {error,db_is_encrypted}
open encrypted space with spec: ok` },
  { title: 'Gérer le départ du client',
    body: 'Supprimer l’espace efface sa base, la marque comme supprimée dans le registre et révoque chaque droit émis pour elle. Un espace chiffré a besoin de sa spécification pour être ouvert et supprimé.',
    label: 'Erlang', lang: 'erlang',
    code: `ok = barrel_spaces:drop_space(Acme,
                              #{encryption => Enc}),
{error, space_dropped} = barrel_spaces:open_space(Acme).`,
    outLabel: 'D’après une exécution enregistrée (droits listés après la suppression)',
    out: `open dropped: {error,space_dropped}
grants after drop: [true,true]   %% revoked_at > 0` },
];
