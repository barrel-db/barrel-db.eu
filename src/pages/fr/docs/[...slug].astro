---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../../legacy/layouts/DocsLayout.astro';
import { docsNavFr, docsOrderFr } from '../../../legacy/docs-nav';

export async function getStaticPaths() {
  const entries = await getCollection('docsFr');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const slug = entry.id;
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  slug={slug}
  headings={headings}
  lang="fr"
  base="/fr/docs"
  nav={docsNavFr}
  order={docsOrderFr}
>
  <Content />
</DocsLayout>
