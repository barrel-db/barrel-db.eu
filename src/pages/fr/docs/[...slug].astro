---
// translation_of: src/pages/docs/[...slug].astro source_hash: 5812d11efce2786b
import { render } from 'astro:content';
import Docs from '../../../layouts/Docs.astro';
import { allDocsFr, siteFile } from '../../../lib/docs';

export async function getStaticPaths() {
  const entries = await allDocsFr();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
---

<Docs title={d.title} description={d.description} slug={entry.id} headings={headings}
      source={d.source} status={d.status} file={siteFile(entry)}>
  <Content />
</Docs>
