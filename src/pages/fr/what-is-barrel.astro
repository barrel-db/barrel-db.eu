const L = (p: string) => localize(p, 'fr');

const builds = [
  { title: 'Un assistant qui se souvient de vos clients', body: 'Il retrouve les conversations passées et les informations du compte au lieu de redemander, et trouve le bon article d’aide même quand le client emploie d’autres mots.', href: '/use-cases/agent-memory' },
  { title: 'Une recherche privée dans les documents de l’entreprise', body: 'Contrats, manuels et notes restent sur vos propres serveurs. Les équipes et les assistants y cherchent par le sens, et le modèle d’IA de votre choix répond à partir de ces documents.', href: '/use-cases/private-rag' },
  { title: 'Des agents qui travaillent ensemble', body: 'Chaque agent a ses propres données et seulement les accès qu’on lui donne. L’un peut confier une tâche à un autre, avec ce qui est fait et ce qui reste à faire.', href: '/use-cases/database-per-agent' },
  { title: 'Des applications qui fonctionnent hors ligne', body: 'Une application de terrain ou un site mal connecté continue de travailler sur sa propre copie et se remet à jour quand la connexion revient, sans perdre les modifications de personne.', href: '/use-cases/offline-first' },
  { title: 'Plusieurs sites qui restent en phase', body: 'Bureaux, usines ou régions gardent chacun leurs données au plus près. Chaque copie accepte les modifications, et toutes se remettent d’accord dès qu’elles peuvent communiquer.', href: '/use-cases/write-on-every-node' },
];

const different = [
  { title: 'Vos données restent là où vous le décidez', body: 'Barrel fonctionne à l’intérieur de votre application ou sur vos propres serveurs. Rien n’a besoin d’être envoyé à un service extérieur, et les données peuvent être chiffrées sur le disque.' },
  { title: 'Il continue de fonctionner sans connexion', body: 'Chaque copie accepte des modifications de son côté, sur un serveur, un appareil ou dans un navigateur, et les copies se remettent d’accord plus tard. Aucune modification ne disparaît sans qu’on le sache.' },
  { title: 'Un seul endroit au lieu de quatre', body: 'Les textes, les fichiers, les informations qui permettent de chercher par le sens et l’historique des modifications sont rangés ensemble. Moins de systèmes à faire tourner, rien à synchroniser à la main.' },
  { title: 'Rien n’est écrasé sans laisser de trace', body: 'Les versions précédentes sont gardées aussi longtemps que vous le choisissez, et chaque modification peut indiquer qui l’a faite. Vous pouvez voir ce qu’un assistant savait à un moment donné, ou essayer un changement sur une copie avant de l’appliquer.' },
  { title: 'L’accès se donne, il ne se suppose pas', body: 'Chaque agent ou chaque client peut avoir son propre espace, avec sa propre clé. L’accès est accordé en lecture ou en écriture, et peut être retiré à tout moment.' },
