import Base from '../../layouts/Base.astro';
import { localize } from '../../i18n';

const offers = [
  {
    id: 'rag',
    title: 'Pilote RAG privé',
    accent: 'coral',
    text: 'Déployez Barrel DB pour la recherche sémantique privée et le RAG sur vos propres données. Nous vous aidons sur l’ingestion, les embeddings, la recherche hybride, le filtrage par métadonnées, l’évaluation et le déploiement.',
    bullets: [
      'Barrel Vector et documents sous un même identifiant',
