    cta: 'Discuter d’un pilote RAG',
    subject: 'Pilote%20RAG%20priv%C3%A9',
  },
  {
    id: 'agent-memory',
    title: 'Pilote mémoire d’agent',
    accent: 'accent',
    text: 'Utilisez Barrel comme couche de mémoire persistante pour vos agents d’IA et vos outils MCP. Stockez documents, vecteurs, blobs, sessions et capacités derrière une seule API.',
    bullets: [
      'accès REST et MCP',
      'espaces, sessions, passations',
      'modèle de capacités sécurisé',
      'déploiement prêt pour l’observabilité',
    ],
    cta: 'Discuter de la mémoire d’agent',
    subject: 'Pilote%20m%C3%A9moire%20d%E2%80%99agent',
  },
  {
    id: 'edge-sync',
    title: 'Pilote synchronisation en périphérie / local-first',
    accent: 'accent',
    text: 'Construisez des déploiements hors ligne d’abord ou en périphérie, avec synchronisation, versions et recherche locale. Gardez les données près des utilisateurs et synchronisez dès que la connexion le permet.',
    bullets: [
      'synchronisation des documents et gestion des conflits',
      'recherche vectorielle locale',
      'modèles de déploiement navigateur/périphérie',
      'stockage local chiffré',
    ],
    cta: 'Discuter de la synchronisation en périphérie',
    subject: 'Pilote%20synchronisation%20en%20p%C3%A9riph%C3%A9rie',
  },
  {
    id: 'managed',
    title: 'Barrel DB géré',
    accent: 'coral',
    text: 'Faites tourner Barrel DB avec l’aide opérationnelle d’Enki Bridge. Disponible pour des partenaires de conception sélectionnés et des utilisateurs en production.',
    bullets: [
