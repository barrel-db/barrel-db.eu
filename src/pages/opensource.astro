---
import Base from '../layouts/Base.astro';
import { components, componentGroups, GITHUB } from '../data/site';
---

<Base title="Open source" description="Every Barrel library is open source under the Apache 2.0 license. Use the whole database or only the piece you need.">
  <section class="wrap os-top">
    <h1 class="display os-h1">Open source, all of it</h1>
    <p class="lead">Every Barrel library is released under the Apache License 2.0. Use it commercially, modify it, run it privately. Enki Bridge earns its living from support and managed infrastructure, not from access to the code.</p>
    <p class="os-cta"><a class="button button--primary" href={GITHUB}>Source on GitHub</a><a class="button" href="/docs/contribute/build-and-test">Build and test it</a></p>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="h2">The libraries</h2>
      <p class="section-intro">One repository, one database made of libraries you can also use on their own.</p>
      <div class="os-groups">
        {componentGroups.map((g) => (
          <div>
            <h3 class="os-g">{g}</h3>
            {components.filter((c) => c.group === g).map((c) => (
              <p class="os-lib">
                <a href={`/product/${c.slug}`}><code>{c.name}</code></a> <span class="small muted">{c.version}</span><br />
                <span class="muted small">{c.body}</span>
              </p>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap os-two">
      <div>
        <h2 class="h3">The license</h2>
        <p>Apache 2.0 lets you use Barrel commercially, modify and redistribute it, use it privately, and grants a patent license. You keep the license and copyright notices and state your changes.</p>
        <p><a href={`${GITHUB}/blob/main/LICENSE`}>Read the license</a></p>
      </div>
      <div>
        <h2 class="h3">Contribute</h2>
        <ul>
          <li>Fix or extend the docs: every page has an "Edit this page" link.</li>
          <li>Discuss a feature or report a bug in <a href={`${GITHUB}/issues`}>GitHub issues</a>.</li>
          <li>Send a pull request: <a href="/docs/contribute/build-and-test">build and test</a> explains the suites it must pass.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="h3">Support and managed hosting</h2>
      <p class="section-intro">The code is free. If you need guaranteed response times, help with a deployment, or someone else to run it, Enki Bridge offers <a href="/commercial">commercial support and managed Barrel in the EU</a>.</p>
    </div>
  </section>
</Base>

<style>
  .os-top { padding-top: 72px; padding-bottom: 56px; }
  .os-h1 { font-size: clamp(2.5rem, 5vw, 3.75rem); margin-bottom: 20px; }
  .os-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .os-groups { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px 40px; }
  .os-g { font-size: 17px; border-bottom: 1px solid var(--rule); padding-bottom: 6px; margin: 0 0 8px; }
  .os-lib { margin: 0 0 12px; }
  .os-lib code { background: none; padding: 0; font-size: 15px; }
  .os-two { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; }
  @media (max-width: 820px) { .os-groups, .os-two { grid-template-columns: minmax(0, 1fr); } }
</style>
