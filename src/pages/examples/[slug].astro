---
import Base from '../../layouts/Base.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { examples, REPO_TREE, type Example } from '../../components/example/examples';
import { readme, source, expected, langOf } from '../../components/example/files';

export function getStaticPaths() {
  return examples.map((e) => ({ params: { slug: e.slug }, props: { example: e } }));
}

interface Props { example: Example; }
const { example } = Astro.props;
const { Content } = readme(example.slug);
const files = example.files.map((path) => ({ path, code: source(example.slug, path) }));
const output = expected(example.slug).replace(/\n$/, '');
const download = `${REPO_TREE}/${example.slug}`;
---

<Base title={example.title} description={example.summary}>
  <article class="wrap ex">
    <nav aria-label="Breadcrumb" class="ex-crumbs">
      <a href="/examples">Examples</a> / <span>{example.runs}</span>
    </nav>

    <div class="ex-readme">
      <Content />
    </div>

    <p class="ex-actions">
      <a class="button button--primary button--small" href={download}>Download</a>
      <span class="small muted">The folder on GitHub, with every file below.</span>
    </p>

    <section aria-labelledby="ex-source">
      <h2 id="ex-source" class="ex-h2">Source</h2>
      {files.map((f) => <CodeBlock code={f.code.replace(/\n$/, '')} lang={langOf(f.path)} label={f.path} />)}
    </section>

    <section aria-labelledby="ex-output">
      <h2 id="ex-output" class="ex-h2">Expected output</h2>
      <p class="muted">The <code>expected.txt</code> of the example, from a real run. Revisions, ids, tokens and timestamps differ on every run; <code>scripts/verify-examples.sh</code> masks them before it compares.</p>
      <CodeBlock code={output} output label="expected.txt" />
    </section>

    <section aria-labelledby="ex-related" class="ex-related">
      <h2 id="ex-related" class="ex-h2">Related</h2>
      <ul>
        {example.useCase && <li>Use case: <a href={example.useCase.href}>{example.useCase.label}</a></li>}
        {example.docs.map((d) => <li>Docs: <a href={d.href}>{d.label}</a></li>)}
        <li><a href="/examples">All examples</a></li>
      </ul>
    </section>
  </article>
</Base>

<style>
  .ex { max-width: 860px; padding-top: 28px; padding-bottom: 80px; }
  .ex-crumbs { font-size: 14px; color: var(--ink-2); margin-bottom: 14px; }
  .ex-crumbs a { color: var(--ink-2); }
  .ex-readme { font-size: 17px; }
  .ex-readme :global(h1) { font-size: clamp(2.25rem, 4vw, 3rem); font-stretch: 112%; letter-spacing: -0.03em; line-height: 1.05; margin: 0 0 16px; }
  .ex-readme :global(h1 + p) { font-size: 19px; line-height: 1.55; }
  .ex-readme :global(h2), .ex-h2 { font-size: 1.75rem; font-stretch: 108%; letter-spacing: -0.015em; margin: 44px 0 12px; }
  .ex-readme :global(h3) { font-size: 1.25rem; margin: 28px 0 8px; }
  .ex-readme :global(p), .ex-readme :global(ul), .ex-readme :global(ol) { margin: 0 0 16px; }
  .ex-readme :global(li) { margin-bottom: 6px; }
  .ex-readme :global(pre) { margin: 0 0 20px; }
  .ex-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; margin: 32px 0 0; padding: 18px 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .ex-related ul { padding-left: 1.2em; }
  .ex-related li { margin-bottom: 6px; }
</style>
