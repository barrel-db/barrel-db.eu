---
import Base from '../layouts/Base.astro';
import RecordFigure from '../components/RecordFigure.astro';
import TwoSiteDemo from '../components/demos/TwoSiteDemo.astro';
import UseCaseTabs from '../components/UseCaseTabs.astro';
import CodeTabs from '../components/CodeTabs.astro';
import SectionMenu from '../components/SectionMenu.astro';

const G = (slug: string) => `/docs/concepts/glossary#${slug}`;

const places = [
  { title: 'Embedded', when: 'Inside your Erlang/OTP release. No network hop, no separate service to run.', href: '/docs/start/quickstart-embedded',
    fits: 'Fits an Erlang or Elixir application that owns its data. You add <code>barrel</code> as a dependency and call it as a library, with the full API.',
    start: 'Quickstart: embedded', layers: [
    { name: 'Your application', note: 'agents, workers, OTP processes', edge: 'calls the barrel API' },
    { name: 'barrel', note: 'records, search, branches', edge: 'stores in', rec: true },
    { name: 'RocksDB on local disk', note: 'documents, attachments, vectors' } ] },
  { title: 'Server', when: 'One node many clients share: agents over MCP, services over REST, other nodes over the sync wire.', href: '/docs/start/quickstart-server',
    fits: `Fits clients in other languages or on other machines, and AI agents that connect through <a href="${G('mcp')}">MCP</a>, the protocol agent tools use to call outside services. Start here if you do not write Erlang.`,
    start: 'Quickstart: server', layers: [
    { name: 'Agents and services', note: 'MCP clients, curl, your backend', edge: 'MCP at /mcp, REST at /db' },
    { name: 'barrel_server', note: 'auth, capability tokens, spaces', edge: 'calls' },
    { name: 'barrel', note: 'the same embedded database', rec: true } ] },
  { title: 'Browser', when: 'A local copy in a web app. Reads and writes keep working offline.', href: '/docs/start/quickstart-browser',
    fits: 'Fits a web app whose users must keep working without a connection. The browser copy syncs with a <code>barrel_server</code>, which holds the durable copy, so you run one too.',
    start: 'Quickstart: browser', layers: [
    { name: 'Your web app', note: 'TypeScript', edge: 'reads and writes locally' },
    { name: 'barrel-lite', note: 'stores in the browser (OPFS)', edge: 'syncs over /db/:db/_sync', rec: true },
    { name: 'barrel_server', note: 'the copy it syncs with' } ] },
];

const status = [
  { title: 'Works today', kind: 'today', items: ['Documents, attachments, every version kept', 'Vector, keyword (BM25) and hybrid search', 'Substring and regex search', 'BQL queries and live subscriptions', 'Active-active replication: nodes and browsers', 'Branches and point-in-time recovery', 'Encryption at rest', 'Spaces, sessions, capability tokens, handoffs', 'REST and MCP server'] },
  { title: 'Optional, needs setup', kind: 'optional', items: ['Local embeddings (Python virtualenv)', 'Cloud embedding providers (API key)', 'Reranking (Python virtualenv)', 'FAISS index backend (system FAISS)', 'S3-compatible attachment storage'] },
  { title: 'Planned', kind: 'planned', items: ['Live federated queries across contexts', 'Rank fusion and reranking across contexts', 'Context catalog enrollment'] },
];

const repPoints = [
  ['Same answer everywhere.', 'Every copy picks the same winner for every document.'],
  ['No lost edits.', 'Concurrent edits stay as conflicts until you resolve them.'],
  ['Resumes after failure.', 'Checkpoints per batch; tested under kills and power cuts.'],
  ['Documents and files.', 'Attachments travel with their documents.'],
];

const quick = [
  { label: 'Erlang', lang: 'erlang', code: `{ok, _} = application:ensure_all_started(barrel),
{ok, Db} = barrel:open(<<"kb">>, #{vectordb => none}),
{ok, _} = barrel:put_doc(Db, #{<<"id">> => <<"kb-142">>,
    <<"title">> => <<"Reset a locked account">>}),
{ok, Rows, _} = barrel:query(Db,
    <<"SELECT id, title FROM kb WHERE id = 'kb-142'">>).` },
  { label: 'REST', lang: 'bash', code: `curl -X PUT localhost:8080/db/kb
curl -X PUT localhost:8080/db/kb/doc/kb-142 \\
  -H 'content-type: application/json' \\
  -d '{"title":"Reset a locked account"}'
curl -X POST localhost:8080/db/kb/query \\
  -H 'content-type: text/plain' \\
  --data-binary "SELECT id, title FROM kb WHERE id = 'kb-142'"` },
  { label: 'TypeScript', lang: 'ts', code: `import { Database } from "barrel-lite";

const db = await Database.open("kb", {
  remote: { url: "http://localhost:8080", db: "kb", token },
});
await db.put({ id: "kb-142", title: "Reset a locked account" });
await db.sync();   // push local writes, then pull` },
];
---

<Base title="Barrel">
  <section class="wrap hero">
    <div class="hero-text">
      <h1 class="display">A database for agents.</h1>
      <p class="lead">Give every agent, customer and task its own database. Barrel keeps the document, the files attached to it and its vector under one id. You search it by meaning and by keyword, keep every version, branch it to try things, sync it to other nodes and browsers, and share it through capability tokens.</p>
      <p class="hero-why">You need this when agents read and write the data your application runs on: support articles, tasks, notes, code. Usually each item is split across a document store, a file store and a vector index, and your code keeps the three in step. In Barrel they form one <a href={G('record')}>record</a>, so the files and the vector stay tied to the document they belong to.</p>
      <p class="muted hero-sub">Every copy takes writes, on a server, at the edge or in a browser, and replication brings them back into agreement without losing an edit. Embedded in Erlang, served over REST and MCP. Open source, Apache 2.0.</p>
      <p class="hero-cta">
        <a class="button button--primary" href="#start">Get started</a>
        <a class="button" href="/what-is-barrel">What is Barrel?</a>
      </p>
      <div class="hero-install">
        <p class="small muted">Add it to your rebar.config</p>
        <code>{'{deps, [{barrel, "~> 1.12"}]}.'}</code>
      </div>
    </div>
    <RecordFigure animate caption="One id ties them together. The vector follows every edit and delete of the document, and replication carries the document and its files to other copies." />
  </section>

  <section class="section" id="replication">
    <div class="wrap rep">
      <div>
        <h2 class="h2">Every copy takes writes</h2>
        <p><a href={G('active-active')}>Active-active</a> <a href={G('replication')}>replication</a> means every copy of a database accepts writes. There is no leader or primary that the others must reach first, so sites, edge nodes and browsers each keep working while the network between them is down.</p>
        <p>When they reconnect, the copies exchange their changes and <a href={G('convergence')}>converge</a>: they end up with the same documents and agree on the same version of each one. You need this when a site, a device or a browser must keep working through a lost connection, or when people in several places edit the same data.</p>
        <ul class="rep-points">
          {repPoints.map(([t, b]) => <li><strong>{t}</strong> <span class="muted">{b}</span></li>)}
        </ul>
        <a href="/product/replication"><strong>How replication works, and how it is tested</strong></a>
      </div>
      <TwoSiteDemo />
    </div>
  </section>

  <section class="section" id="use-cases">
    <div class="wrap">
      <h2 class="h2">What you build with it</h2>
      <p class="section-intro">Eight architectures Barrel is made for. Each tab starts from a problem you may already have, such as keeping agents from reading each other's data or keeping an app working offline, then shows how Barrel handles it: the pieces involved and the code. Pick the one closest to what you are building; each has its own page and a runnable example.</p>
      <UseCaseTabs />
    </div>
  </section>

  <section class="section" id="start">
    <div class="wrap">
      <h2 class="h2">Three places to run it</h2>
      <p class="section-intro">This is where you start. Barrel is the same database in all three places: the same record, the same replication protocol, so copies in different places can sync with each other. Pick where the database lives from what your application is written in, whether its clients reach it over the network, and whether it must work offline. The agents that use it don't change, and you can add the other places later.</p>
      <div class="three">
        {places.map((p) => (
          <div>
            <h3 class="pl-t"><a href={p.href}>{p.title}</a></h3>
            <p class="muted small pl-w">{p.when}</p>
            <ol class="stack" aria-label={`${p.title} layers, top to bottom`}>
              {p.layers.map((l) => (
                <li>
                  <div class:list={['layer', { 'is-rec': l.rec }]}><strong>{l.name}</strong><span>{l.note}</span></div>
                  {l.edge && <p class="edge">{l.edge}</p>}
                </li>
              ))}
            </ol>
            <p class="small pl-f" set:html={p.fits} />
            <p class="small pl-s"><a href={p.href}><strong>{p.start}</strong></a></p>
          </div>
        ))}
      </div>
      <p class="small">Not sure which one fits? <a href="/docs/start/choose-deployment">Choose a deployment</a> compares the three in one table: what each gives you and what to know before you pick.</p>
    </div>
  </section>

  <section class="section" id="try-it">
    <div class="wrap">
      <h2 class="h2">Try it in two minutes</h2>
      <p class="section-intro">Each tab writes the support article <code>kb-142</code> and reads it back with a query in <a href={G('bql')}>BQL</a>, Barrel's SQL-like query language. The Erlang tab calls the library directly and opens the database without a vector store, so it needs no embedding model. The REST tab talks to a running <code>barrel_server</code> with curl. The TypeScript tab writes to the browser copy, then syncs it with the server. Pick the tab that matches where you run Barrel, then follow its quickstart to set it up.</p>
      <div class="quick"><CodeTabs tabs={quick} /></div>
    </div>
  </section>

  <section class="section" id="status">
    <div class="wrap">
      <h2 class="h2">What works today, and what doesn't yet</h2>
      <p class="section-intro">Check a feature's mark before you plan around it. Works today means it works in the current release and is covered by the test suites. Optional means it works once you install or configure something, such as a Python virtualenv or an API key. Planned means it is not built yet, so do not depend on it. Every page carries the same three marks, and anything without a mark works today.</p>
      <div class="status">
        {status.map((g) => (
          <div>
            <h3 class={`mark mark--${g.kind} st-h`}>{g.title}</h3>
            <ul>{g.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
      <p class="small"><a href="/product/status">Status of every feature</a></p>
    </div>
  </section>
  <SectionMenu openFrom={1760} items={[
  { id: 'replication', text: 'Every copy takes writes' },
  { id: 'use-cases', text: 'What you build with it' },
  { id: 'start', text: 'Three places to run it' },
  { id: 'try-it', text: 'Try it in two minutes' },
  { id: 'status', text: 'What works today' },
  ]} />
</Base>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 48px; align-items: center; padding-top: 88px; padding-bottom: 72px; }
  .hero .display { margin-bottom: 28px; }
  .hero .lead { margin: 0 0 20px; }
  .hero-sub { max-width: 36em; margin: 0 0 32px; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; margin: 0 0 32px; }
  .hero-install { border-top: 1px solid var(--rule); padding-top: 16px; max-width: 34em; }
  .hero-install p { margin: 0 0 6px; }
  .hero-install code { background: none; padding: 0; font-size: 15px; }
  .rep { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 48px; align-items: start; }
  .rep-points { list-style: none; padding: 0; margin: 0 0 24px; }
  .rep-points li { padding: 10px 0; border-top: 1px solid var(--rule); }
  .three { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin-bottom: 20px; }
  .pl-t { font-size: var(--step-1); margin: 0 0 4px; }
  .pl-t a { color: var(--ink); text-decoration: none; }
  .pl-w { min-height: 4.8em; margin: 0 0 16px; }
  .pl-f { margin: 16px 0 8px; }
  .pl-s { margin: 0; }
  .section-intro { max-width: 68ch; }
  .hero-why { max-width: 36em; margin: 0 0 20px; }
  .stack { list-style: none; margin: 0; padding: 0; }
  .layer { padding: 12px 14px; border: 1.5px solid var(--ink); border-radius: 6px; background: var(--card); display: flex; flex-direction: column; }
  .layer span { font-size: 13px; color: var(--ink-2); }
  .layer.is-rec { background: var(--coral); border-color: var(--coral); color: var(--on-coral); }
  .layer.is-rec span { color: var(--on-coral); opacity: 0.9; }
  .edge { margin: 0 0 0 16px; padding: 6px 0 6px 12px; border-left: 1.5px solid var(--teal); font-size: 13px; color: var(--teal); }
  .quick { max-width: 820px; }
  .status { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; margin-bottom: 16px; }
  .st-h { font-size: 19px; margin: 0 0 12px; }
  .status ul { list-style: none; margin: 0; padding: 0; }
  .status li { padding: 8px 0; border-top: 1px solid var(--rule); font-size: 15px; }
  @media (max-width: 900px) {
    .hero, .rep, .three, .status { grid-template-columns: minmax(0, 1fr); }
    .hero { padding-top: 48px; }
  }
</style>
