---
import ProductFrame from '../../components/product/ProductFrame.astro';
import Guarantees from '../../components/product/Guarantees.astro';
import Related from '../../components/product/Related.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import CodeTabs from '../../components/CodeTabs.astro';
import TwoSiteDemo from '../../components/demos/TwoSiteDemo.astro';
import MeshDemo from '../../components/demos/MeshDemo.astro';

const guarantees = [
  { title: 'Every copy agrees', body: 'Copies converge to the same winner, body and deletion state for every document, whatever order the writes arrive in.', check: 'a TLA+ model of three replicas with crashes, Lean proofs of the merge laws, and the three-peer active-active script.' },
  { title: 'No write is lost', body: 'A write replaces only the versions it read. Concurrent edits stay side by side as conflicts until someone resolves them.', check: 'an Ivy proof for any number of replicas and writers, and the active-active script (nine edits over the winner, the losing write stays).' },
  { title: 'Safe to retry', body: 'Delivery is idempotent, so a batch sent twice changes nothing. Checkpoints after each batch let a run resume where it stopped.', check: 'the crash script, which kills the target mid-batch and then the peer running the task.' },
  { title: 'Survives power cuts', body: 'Writes made with `sync => true` survive a power loss. A copy that loses a batch it had acknowledged gets it again on the next run.', check: 'the power-fail script on LazyFS, which drops every write that was not flushed to disk.' },
  { title: 'Files travel with documents', body: 'Attachments replicate in their own phase, streamed in chunks, and the checkpoint only moves past what the target confirmed it stored.', check: 'the replication script, including an attachment added with no document change.' },
  { title: 'Rolling upgrades', body: 'A peer on the previous release keeps replicating with upgraded peers both ways. Its edits show up as conflicts, never as lost writes.', check: 'the mixed-version script against barrel_server 1.11.1.' },
];

type Chip = { label: string; x: string; y: string; rec?: boolean };
const topos: { title: string; body: string; edge: string; nodes: Chip[] }[] = [
  { title: 'Two sites, both ways', body: 'Both take writes; a task in each direction keeps them close.', edge: 'push and pull', nodes: [{ label: 'Paris', x: '28%', y: '45%', rec: true }, { label: 'Lyon', x: '72%', y: '45%', rec: true }] },
  { title: 'Hub and edges', body: 'Edges push to a hub and pull back what others wrote.', edge: 'continuous tasks', nodes: [{ label: 'hub', x: '50%', y: '28%' }, { label: 'edge 1', x: '20%', y: '68%', rec: true }, { label: 'edge 2', x: '50%', y: '68%', rec: true }, { label: 'edge 3', x: '80%', y: '68%', rec: true }] },
  { title: 'A subset per device', body: 'A channel or a query filter decides what each copy gets.', edge: 'filter at the source', nodes: [{ label: 'central', x: '50%', y: '28%' }, { label: 'channel mobile', x: '50%', y: '68%', rec: true }] },
  { title: 'Browsers', body: 'barrel-lite keeps a copy in the browser and syncs over the same wire.', edge: '/db/:db/_sync', nodes: [{ label: 'barrel_server', x: '50%', y: '28%' }, { label: 'tab A', x: '28%', y: '68%', rec: true }, { label: 'tab B', x: '72%', y: '68%', rec: true }] },
];

const run = [
  { body: 'Read the checkpoint to find the last change shipped.' },
  { body: 'Fetch changes since then, filtered at the source.' },
  { body: 'Ask the target which versions it lacks, in one round trip.' },
  { body: 'Send the missing document states; applying one twice is harmless.', key: true },
  { body: 'Checkpoint the batch, then send the attachments.' },
];

const local = `{ok, Result} = barrel_rep:replicate(<<"paris">>, <<"lyon">>),
#{docs_written := N} = Result.`;

const http = `Lyon = barrel_rep_transport_http:endpoint(
    <<"http://lyon.example:8080/db/tasks">>),

%% push, then pull
{ok, _} = barrel_rep:replicate(<<"tasks">>, Lyon,
    #{target_transport => barrel_rep_transport_http}),
{ok, _} = barrel_rep:replicate(Lyon, <<"tasks">>,
    #{source_transport => barrel_rep_transport_http}).`;

const task = [
  { label: 'Erlang', lang: 'erlang', code: `{ok, TaskId} = barrel_rep_tasks:start_task(#{
    source    => <<"tasks">>,
    target    => <<"http://lyon.example:8080/db/tasks">>,
    mode      => continuous,
    direction => both}).` },
  { label: 'TypeScript', lang: 'ts', code: `import { Database } from "barrel-lite";

const db = await Database.open("tasks", {
  remote: { url: "https://lyon.example:8080",
            db: "sp_...", token: "bsp_..." },
});
const live = db.liveSync();   // push and pull, adaptive
// live.stop();` },
];

const conflict = `barrel_docdb:get_conflicts(<<"edge_a">>, <<"task:1">>).

{ok, #{<<"_observed">> := Seen}} =
    barrel_docdb:get_doc(<<"edge_a">>, <<"task:1">>,
                         #{conflicts => true}).

barrel_docdb:resolve_conflict(<<"edge_a">>, <<"task:1">>,
    Seen, {merge, Merged}).`;

const conflictOut = `{ok,[<<"000001a1b879d59100000000@w7bcb971434496877">>]}

{ok,#{id => <<"task:1">>, conflicts_resolved => 1,
      rev => <<"000001a1b879d59500000000@w7bcb971434496877">>}}`;

const limits = [
  'Vector indexes. With record mode the text and metadata replicate and each copy rebuilds its index; a client can pull stored vectors with the documents.',
  'Provenance. Who wrote a document stays on the origin’s history; on other copies the arrival is recorded as replicated, from that origin.',
  'The barrel API. Replication runs on the document layer: call `barrel_rep` and `barrel_rep_tasks` with the database name.',
  'Client certificates over HTTP/3. Use HTTP/1.1 or HTTP/2 with TLS when you need mTLS between nodes.',
  'Channels do not delete documents that leave a channel from the replicas that already hold them.',
];
---

<ProductFrame
  title="Replication"
  description="Active-active replication in Barrel: every copy takes writes, picks the same winner, keeps concurrent edits as conflicts and resumes after a crash."
  heading="Write on every copy."
  lead="Every Barrel database takes writes: on a server, on an edge node, in a browser. Replication keeps the copies in agreement. They pick the same winner everywhere, keep every concurrent edit until you resolve it, and resume where they stopped after a crash."
  sub="No leader, no primary, no quorum to wait for. Each copy works on its own and catches up when it can reach the others."
  ctas={[{ label: 'Set up replication', href: '/docs/guides/synchronization' }, { label: 'Read the proofs', href: '/docs/architecture/replication-proofs' }]}
>
  <section class="wrap rp-demo">
    <TwoSiteDemo />
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="h2">What it guarantees, and how we check</h2>
      <p class="section-intro">Each property names what tests it. The proofs and the end-to-end scripts are in the repository; you can run them yourself.</p>
      <Guarantees items={guarantees} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="h2">A mesh, and a browser that goes offline</h2>
      <p class="section-intro">Cut the link between Paris and Berlin and their edits still meet, relayed through Lyon. Take the browser offline: it keeps reading and writing, counts what it has not pushed, and catches up with one sync.</p>
      <MeshDemo />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="h2">Topologies</h2>
      <p class="section-intro">One protocol, in the same VM or over HTTP. Arrange the copies the way your network is.</p>
      <ul class="rp-topo">
        {topos.map((t) => (
          <li>
            <div class="rp-tbox" role="img" aria-label={`${t.title}: ${t.nodes.map((n) => n.label).join(', ')}; ${t.edge}`}>
              {t.nodes.map((n) => <span class:list={['rp-chip', { 'is-rec': n.rec }]} style={`left:${n.x};top:${n.y}`}>{n.label}</span>)}
              <span class="rp-tedge">{t.edge}</span>
            </div>
            <h3 class="rp-tt">{t.title}</h3>
            <p class="small muted rp-tb">{t.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="h2">One run, step by step</h2>
      <p class="section-intro">A one-shot run and a continuous task do the same thing; a task just keeps doing it.</p>
      <ol class="rp-run">
        {run.map((r, i) => (
          <li class:list={{ 'is-key': r.key }}>
            <span class="rp-n">{i + 1}</span>
            <p>{r.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap pf-narrow">
      <h2 class="h2">Set it up</h2>

      <h3 class="pf-h3">Between two databases on one node</h3>
      <p class="pf-p">Run it again later to pick up new changes; it resumes from its checkpoint.</p>
      <CodeBlock code={local} />

      <h3 class="pf-h3">To another node, over HTTP</h3>
      <p class="pf-p">The other side is a database under a running barrel_server.</p>
      <CodeBlock code={http} />

      <h3 class="pf-h3">Keep it running</h3>
      <p class="pf-p">A task survives restarts and catches up after an outage. In the browser, barrel-lite syncs over the same wire.</p>
      <CodeTabs tabs={task} />
      <p class="small muted">Credentials come from the server configuration, never from the task itself.</p>

      <h3 class="pf-h3">A conflict, from a recorded run</h3>
      <p class="pf-p">Both sites edited task:1 while apart, then replicated both ways.</p>
      <CodeBlock code={conflict} />
      <CodeBlock code={conflictOut} output label="Output of get_conflicts and resolve_conflict, recorded on barrel_docdb 2.1.0" />
      <p class="small muted">After one more replication, edge_b holds the resolved version and no conflict.</p>
    </div>
  </section>

  <Related
    title="What does not replicate yet"
    limits={limits}
    docs={['guides/synchronization', 'replicate/conflicts', 'architecture/replication-proofs', 'contribute/end-to-end-tests', 'guides/barrel-lite']}
    more={[{ href: '/use-cases/write-on-every-node', label: 'Use case: write on every node' }]}
    libs={['docdb', 'server', 'lite']}
  />
</ProductFrame>

<style>
  .rp-demo { padding-bottom: 72px; }
  .rp-topo { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .rp-tbox { height: 180px; border: 1px solid var(--rule); border-radius: var(--radius); background: var(--card); position: relative; margin-bottom: 14px; }
  .rp-chip { position: absolute; transform: translate(-50%, -50%); padding: 6px 10px; border-radius: 6px; font-size: 13px; font-weight: 600; white-space: nowrap; border: 1.5px solid var(--ink); background: var(--card); }
  .rp-chip.is-rec { background: var(--coral); border-color: var(--coral); color: var(--on-coral); }
  .rp-tedge { position: absolute; left: 12px; bottom: 10px; font-size: 12px; color: var(--teal); font-family: var(--mono); }
  .rp-tt { margin: 0 0 4px; font-size: 19px; }
  .rp-tb { margin: 0; }
  .rp-run { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16px; }
  .rp-run li { border-top: 3px solid var(--ink); padding-top: 12px; min-width: 0; }
  .rp-run li.is-key { border-top-color: var(--coral); }
  .rp-n { font-stretch: 112%; font-weight: 620; font-size: 24px; color: var(--teal); }
  .rp-run p { margin: 4px 0 0; font-size: 15px; }
  @media (max-width: 980px) { .rp-topo, .rp-run { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 820px) { .rp-topo, .rp-run { grid-template-columns: minmax(0, 1fr); } }
</style>
