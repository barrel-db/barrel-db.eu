---
import ProductFrame from '../../components/product/ProductFrame.astro';
import Guarantees from '../../components/product/Guarantees.astro';
import FlowDiagram from '../../components/product/FlowDiagram.astro';
import Related from '../../components/product/Related.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import CodeTabs from '../../components/CodeTabs.astro';

const branchStages = [
  { boxes: [{ name: 'main', note: 'the parent database' }], edge: 'fork: a hard-link checkpoint, O(1)' },
  { boxes: [{ name: 'exp1', note: 'a normal database, its own writer id', rec: true }], edge: 'merge: only what exp1 changed' },
  { boxes: [{ name: 'main', note: 'edits land; concurrent edits become conflicts' }] },
];

const pitrStages = [
  { boxes: [{ name: 'main', note: 'history kept for the retention window' }], edge: 'branch at T' },
  { boxes: [{ name: 'yesterday', note: 'every document as it was at T', rec: true }], edge: 'read, query, serve' },
  { boxes: [{ name: 'Next to today’s data', note: 'main keeps running' }] },
];

const guarantees = [
  { title: 'The branch holds exactly what came before the fork', body: 'The fork instant is taken inside the parent’s writer, so a branch made under write load sees every write applied before it and none after.', check: '`fork_under_write_load` and `fork_isolation` in barrel_timeline_SUITE.' },
  { title: 'A rewind restores state at T', body: 'Documents changed after T come back as they were, documents created after T are gone, deletes after T are undone, and indexes and the changes feed match.', check: 'barrel_timeline_pitr_SUITE: `rewind_updates`, `rewind_forgets_created_after_t`, `rewind_restores_deleted_after_t`, `rewind_query_index`, `rewind_feed_replay`.' },
  { title: 'Merging twice changes nothing', body: 'A merge ships the branch’s documents as whole states and keeps a checkpoint, so a second merge is a no-op and a later one ships only new work.', check: '`merge_idempotent` and `merge_incremental` in barrel_timeline_merge_SUITE.' },
  { title: 'Conflicts follow the replication rules', body: 'Edits made on both sides become regular conflicts, or are settled by the parent’s `conflict_resolver`. Attachments and deletes merge too.', check: '`merge_conflict_lww`, `merge_conflict_merger`, `merge_attachments`, `merge_delete`.' },
  { title: 'Search works on the branch right away', body: 'A record-mode branch rebuilds its vector store from the embeddings stored in the documents, with no embedder calls. After a merge, the parent re-indexes what changed.', check: 'barrel_record_timeline_SUITE: `backfill_stored_vectors_no_embed_calls`, `merge_reindexes_parent`.' },
  { title: 'Outside the window, a clean refusal', body: 'A T below the history floor fails with `pitr_window_exceeded` and leaves nothing behind.', check: '`rewind_floor_guard` in barrel_timeline_pitr_SUITE.' },
];

const branchTabs = [
  { label: 'Erlang', lang: 'erlang', code: `{ok, _} = barrel_docdb:branch_db(<<"main">>, <<"exp1">>, #{}),

%% the branch is a normal database; edits stay on it
{ok, D} = barrel_docdb:get_doc(<<"exp1">>, <<"a">>),
{ok, _} = barrel_docdb:put_doc(<<"exp1">>, D#{<<"v">> => 2}),

%% ship the branch's edits back; rerun any time
{ok, #{docs_written := 1}} =
    barrel_docdb:merge_branch(<<"exp1">>, #{}),
ok = barrel_docdb:delete_db(<<"exp1">>).` },
  { label: 'REST', lang: 'bash', code: `curl -X POST localhost:8080/db/main/_timeline/branch \\
  -H 'content-type: application/json' -d '{"name":"exp1"}'

curl localhost:8080/db/main/_timeline

# called on the branch
curl -X POST localhost:8080/db/exp1/_timeline/merge
curl -X DELETE 'localhost:8080/db/exp1?purge=true'` },
  { label: 'MCP', lang: 'json', code: `{"jsonrpc":"2.0","id":7,"method":"tools/call",
 "params":{"name":"branch_create",
   "arguments":{"db":"main","name":"exp1"}}}

{"jsonrpc":"2.0","id":8,"method":"tools/call",
 "params":{"name":"merge","arguments":{"db":"exp1"}}}` },
];

const pitrTabs = [
  { label: 'Erlang', lang: 'erlang', code: `{ok, _Changes, T} = barrel_docdb:get_changes(<<"main">>, first),
%% ... more writes happen ...
{ok, _} = barrel_docdb:branch_db(<<"main">>, <<"yesterday">>,
                                 #{at => T}).` },
  { label: 'REST', lang: 'bash', code: `curl -X POST localhost:8080/db/main/_timeline/branch \\
  -H 'content-type: application/json' \\
  -d '{"name":"yesterday","at_time":"2026-11-07T09:00:00Z"}'` },
  { label: 'MCP', lang: 'json', code: `{"jsonrpc":"2.0","id":9,"method":"tools/call",
 "params":{"name":"branch_create","arguments":{
   "db":"main","name":"yesterday","at":"<changes cursor>"}}}` },
];

const record = `{ok, Br} = barrel:branch(Db, <<"support_draft">>,
    #{vectordb => #{db_path => "data/support_draft_vec"}}),
barrel:search(Br, <<"export billing CSV">>, #{k => 1}),
{ok, Bd} = barrel:get_doc(Br, <<"kb:201">>),
{ok, _} = barrel:put_doc(Br,
    Bd#{<<"title">> => <<"Export invoices and credit notes">>}),
barrel:merge(Br).`;

const recordOut = `{ok,[#{... key => <<"kb:201">>,score => 0.5059366870734147}]}
{ok,#{failed => [], docs_read => 1, docs_written => 1,
      doc_write_failures => 0, ...}}`;

const nested = `barrel_docdb:branch_db(<<"edge_a_review">>, <<"nested">>, #{}).`;
const nestedOut = `{error,cannot_branch_a_branch}`;

const limits = [
  'Lineage is linear: a branch of a branch is refused with `cannot_branch_a_branch`. Cross-lineage merges are planned.',
  'The rewind window is the retention window: `retention_period`, 30 days by default. Below the history floor, a branch at T fails with `pitr_window_exceeded`.',
  'A branch made at a past instant keeps the attachments as they were at the fork, not at T: attachments have no history.',
  'There is no per-merge conflict policy; the parent’s `conflict_resolver` applies, and the merge report carries counts, not per-document conflict detail.',
  'A plain `barrel` branch starts with an empty vector store: vectors you added with `vector_add` are not carried. Re-add them, or use record mode.',
  '“Revert the parent to T” is not an operation yet; a rewind is a new branch next to the parent.',
  'Runtime settings (channels, `conflict_resolver`, retention, encryption) must be passed again when you reopen a branch, as for any database. A branch that is not open is not listed.',
  'Over REST and MCP, branching and merging need a server credential: capability tokens get 403 on the `_timeline` routes.',
];
---

<ProductFrame
  title="Timeline"
  description="Branch a Barrel database instantly, work on the branch in isolation, merge it back, or branch at a past instant to recover a state."
  heading="Branch a database, merge it back, recover a past state."
  lead="A branch is a full copy of a database made in constant time. Give one to an agent run or an experiment, review what it did, and merge what survived. Branch at a past instant to read yesterday's data next to today's."
  sub="Merging uses the same version vectors as replication: known versions change nothing, edits land, and concurrent edits become conflicts you can see and resolve."
  ctas={[{ label: 'Branch, merge, recover', href: '/docs/guides/timeline' }, { label: 'A branch per agent run', href: '/use-cases/branch-per-run' }]}
>
  <section class="section">
    <div class="wrap">
      <h2 class="h2">What it is</h2>
      <p class="section-intro">A fork takes a hard-link checkpoint of the document and attachment stores, so parent and branch share files until either side compacts. The branch is then an ordinary database: reads, writes, queries, the changes feed and replication all work on it, under its own writer id.</p>
      <FlowDiagram label="Branch and merge" stages={branchStages} />
      <h3 class="pf-h3 tl-gap">Point-in-time recovery</h3>
      <FlowDiagram label="Branch at a past instant" stages={pitrStages} caption="T is a changes cursor (the HLC the feed returns) or, over REST, an RFC 3339 time." />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="h2">What holds, and what tests it</h2>
      <p class="section-intro">Each property names the test cases that check it.</p>
      <Guarantees items={guarantees} />
    </div>
  </section>

  <section class="section">
    <div class="wrap pf-narrow">
      <h2 class="h2">Use it</h2>

      <h3 class="pf-h3">Branch, edit, merge</h3>
      <CodeTabs tabs={branchTabs} />

      <h3 class="pf-h3">Branch at a past instant</h3>
      <p class="pf-p">Every document changed after T is restored to its last state at or before T, including conflicts that were open at that instant.</p>
      <CodeTabs tabs={pitrTabs} />

      <h3 class="pf-h3">A record-mode branch, from a recorded run</h3>
      <p class="pf-p">The branch gets a fresh vector store, filled from the stored embeddings, so search answers before the first edit.</p>
      <CodeBlock code={record} />
      <CodeBlock code={recordOut} output label="Output of the search and the merge, recorded on barrel 1.12.0 (trimmed)" />

      <h3 class="pf-h3">One level of branches</h3>
      <CodeBlock code={nested} />
      <CodeBlock code={nestedOut} output label="Output, recorded on barrel_docdb 2.1.0" />
    </div>
  </section>

  <Related
    limits={limits}
    docs={['guides/timeline', 'guides/audit-provenance', 'operate/backups', 'concepts/versions']}
    more={[{ href: '/use-cases/branch-per-run', label: 'Use case: a branch per agent run' }]}
    libs={['docdb', 'barrel', 'server']}
  />
</ProductFrame>

<style>
  .tl-gap { margin-top: 48px; margin-bottom: 16px; }
</style>
