---
import Base from '../../layouts/Base.astro';
import { capabilities, components, componentGroups, statusLabel } from '../../data/site';
import { componentContent } from '../../data/components';

const groups = componentGroups.map((g) => ({ title: g, items: components.filter((c) => c.group === g) }));
const install = (slug: string) => {
  const code = componentContent[slug]?.install.code ?? '';
  return code.includes('\n') ? 'Build from the repository' : code;
};

// When you would reach for each capability. The short line stays in site.ts for the menu.
const when: Record<string, string> = {
  replication: 'Use it when sites, devices or browsers must keep taking writes while apart, then agree again without losing an edit.',
  search: 'Use it when agents or people look things up by meaning, by keyword, or by exact text and patterns.',
  timeline: 'Use it when an agent should work on a copy you review before merging, or when you need the data as it was earlier.',
  agents: 'Use it when several agents share one server and each must reach only the data it was given.',
  security: 'Use it when data on disk must stay unreadable without its key, or when the server is reachable from other machines.',
  deployments: 'Read it first if you have not chosen where Barrel runs: inside an Erlang app, as a server, or in a browser.',
};
---

<Base title="Product" description="What Barrel does, and the libraries it is made of: the database, data and search, models, the agent layer, access over HTTP and in the browser, storage and security.">
  <div class="wrap pi">
    <h1 class="pi-title">Product</h1>
    <p class="lead">Barrel is one database made of separate libraries. Use the <code>barrel</code> library for documents, files and vectors in one place, add the server for REST and MCP, or take one library on its own. Each page below says what a library does, when to use it, what it builds on and how to install it.</p>
    <p class="pi-intro">Start with what it does when you know the problem you want to solve: each capability page explains what it does for you and how to use it. Go to the libraries behind it when you already know which part you need and want its version, its status and its install line.</p>

    <div class="pi-grid">
      <section class="pi-caps" aria-labelledby="caps">
        <h2 id="caps" class="pi-h2">What it does</h2>
        <ul>
          {capabilities.map((c) => (
            <li><a href={`/product/${c.slug}`}><span class="pi-cap">{c.name}</span><span class="pi-body">{c.body}</span><span class="pi-when">{when[c.slug]}</span></a></li>
          ))}
        </ul>
      </section>

      <section class="pi-libs" aria-labelledby="libs">
        <div class="pi-libs-head">
          <h2 id="libs" class="pi-h2">The libraries behind it</h2>
          <p class="pi-legend"><span class="mark mark--today">{statusLabel.today}</span><span class="mark mark--optional">{statusLabel.optional}</span></p>
        </div>
        <div class="pi-groups">
          {groups.map((g) => (
            <section aria-label={g.title}>
              <h3 class="pi-group">{g.title}</h3>
              <ul>
                {g.items.map((c) => (
                  <li>
                    <a href={`/product/${c.slug}`} class="pi-lib">
                      <span class={`mark mark--${c.status}`}><code class="pi-name">{c.name}</code></span>
                      <span class="pi-v">{c.version}</span>
                    </a>
                    <span class="pi-body">{c.body}</span>
                    <code class="pi-install">{install(c.slug)}</code>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
        <p class="pi-foot"><a href="/docs/architecture/overview">How the pieces fit</a><a href="/docs/reference/libraries">Libraries reference</a><a href="/docs/features">Status of every feature</a></p>
      </section>
    </div>
  </div>
</Base>

<style>
  .pi { padding-top: 48px; padding-bottom: 88px; }
  .pi-title { margin: 0 0 16px; font-size: clamp(2.5rem, 6vw, 3.75rem); font-weight: 620; font-stretch: 112%; letter-spacing: -0.03em; line-height: 1; }
  .pi .lead { margin: 0 0 16px; }
  .pi-intro { max-width: 68ch; margin: 0 0 48px; color: var(--ink-2); }
  .pi-when { display: block; margin-top: 4px; font-size: var(--step--1); }
  .pi-grid { display: grid; grid-template-columns: 320px minmax(0, 1fr); gap: 56px; align-items: start; }
  .pi-h2 { margin: 0 0 12px; font-size: var(--step-1); font-stretch: 108%; }
  ul { list-style: none; margin: 0; padding: 0; }
  .pi-caps li a { display: block; padding: 12px 0; border-top: 1px solid var(--rule); text-decoration: none; color: var(--ink); }
  .pi-caps li a:hover .pi-cap { text-decoration: underline; }
  .pi-cap { display: block; font-weight: 620; }
  .pi-body { display: block; font-size: var(--step--1); color: var(--ink-2); }
  .pi-libs-head { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px 24px; margin-bottom: 12px; }
  .pi-libs-head .pi-h2 { margin: 0; }
  .pi-legend { margin: 0; display: flex; flex-wrap: wrap; gap: 16px; color: var(--ink-2); }
  .pi-legend .mark { font-weight: 400; }
  .pi-groups { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px 32px; }
  .pi-group { font-size: var(--step--1); font-weight: 650; margin: 0 0 4px; padding-bottom: 6px; border-bottom: 1px solid var(--rule); }
  .pi-groups section { min-width: 0; margin-bottom: 20px; }
  .pi-groups li { padding: 8px 0; }
  .pi-lib { display: flex; align-items: baseline; gap: 8px; text-decoration: none; color: var(--ink); }
  .pi-lib:hover .pi-name { text-decoration: underline; }
  .pi-name { font-size: 15px; background: transparent; padding: 0; }
  .pi-v { font-size: 12px; color: var(--ink-2); }
  .pi-groups .pi-body { padding-left: 18px; }
  .pi-install { display: inline-block; margin: 4px 0 0 18px; font-size: 12px; overflow-wrap: anywhere; }
  .pi-foot { border-top: 1px solid var(--rule); padding-top: 14px; margin: 4px 0 0; display: flex; flex-wrap: wrap; gap: 8px 28px; font-size: 15px; }
  @media (max-width: 1000px) {
    .pi-grid { grid-template-columns: minmax(0, 1fr); gap: 40px; }
  }
  @media (max-width: 820px) {
    .pi-groups { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .pi-groups { grid-template-columns: minmax(0, 1fr); }
  }
</style>
