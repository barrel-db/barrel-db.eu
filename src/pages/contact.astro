---
import Base from '../layouts/Base.astro';
import { GITHUB } from '../data/site';
---

<Base title="Contact" description="Talk to the Barrel team: community chat on Matrix, GitHub issues, or email Enki Bridge about commercial support.">
  <section class="wrap ct-top">
    <h1 class="display ct-h1">Talk to us</h1>
    <p class="lead">A question about Barrel, a bug, or help with a deployment: pick the channel that fits.</p>
  </section>
  <section class="section">
    <div class="wrap ct-grid">
      <div>
        <h2 class="h3">Community</h2>
        <dl class="ct-dl">
          <dt>Matrix chat</dt>
          <dd>Ask questions and follow development. <a href="https://matrix.to/#/#barrel-db:matrix.org">#barrel-db:matrix.org</a></dd>
          <dt>GitHub issues</dt>
          <dd>Report a bug or propose a feature. <a href={`${GITHUB}/issues`}>barrel-db/barrel issues</a></dd>
          <dt>Email</dt>
          <dd>For anything longer. <a href="mailto:hello@barrel-db.eu">hello@barrel-db.eu</a></dd>
        </dl>
      </div>
      <div>
        <h2 class="h3">Commercial</h2>
        <p>Talk to Enki Bridge about a private RAG pilot, agent memory and MCP integrations, edge sync, managed Barrel, backups and monitoring, custom SLAs or private support.</p>
        <p class="ct-cta"><a class="button button--primary" href="mailto:hello@barrel-db.eu?subject=Commercial%20Barrel">Email Enki Bridge</a><a class="button" href="/commercial">See the offers</a></p>
        <h3 class="ct-h">Company</h3>
        <p class="small">Built by Enki Bridge, European Union. Infrastructure on <a href="https://bgp.tools/as/209823">AS209823</a>, data centers in Paris, Amsterdam, Geneva and Lille.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .ct-top { padding-top: 72px; padding-bottom: 48px; }
  .ct-h1 { font-size: clamp(2.5rem, 5vw, 3.75rem); margin-bottom: 16px; }
  .ct-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; }
  .ct-dl dt { font-weight: 650; margin-top: 16px; }
  .ct-dl dd { margin: 4px 0 0; }
  .ct-cta { display: flex; flex-wrap: wrap; gap: 12px; }
  .ct-h { font-size: 17px; margin: 32px 0 6px; }
  @media (max-width: 820px) { .ct-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
