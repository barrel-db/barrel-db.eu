---
import { render } from 'astro:content';
import Docs from '../../layouts/Docs.astro';
import { allDocs, siteFile } from '../../lib/docs';

export async function getStaticPaths() {
  const entries = await allDocs();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
---

<Docs title={d.title} description={d.description} slug={entry.id} headings={headings}
      source={d.source} commit={d.commit} updated={d.updated} status={d.status} file={siteFile(entry)}>
  <Content />
</Docs>
