---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" noindex>
  <section class="wrap nf">
    <h1 class="display nf-h">This page does not exist</h1>
    <p class="lead">It may have moved when the docs were reorganized by task. Search for what you need, or start from one of these.</p>
    <p class="nf-cta">
      <button type="button" class="button button--primary" data-open-search>Search the site</button>
      <a class="button" href="/docs">Documentation</a>
      <a class="button" href="/product">Product</a>
    </p>
    <p class="nf-fr" lang="fr">Cette page n’existe pas. <a href="/fr">Aller à l’accueil en français</a></p>
  </section>
</Base>

<style>
  .nf { padding-top: 96px; padding-bottom: 120px; }
  .nf-h { font-size: clamp(2.5rem, 5vw, 3.75rem); margin-bottom: 20px; }
  .nf-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .nf-fr { margin-top: 40px; color: var(--ink-2); }
</style>
