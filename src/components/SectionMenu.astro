---
// Floating "On this page" menu: the page stays one column and keeps its
// scroll; this panel floats at the right edge and links to the sections.
// It opens by default only when the window leaves room for it beside the
// text (`openFrom`, in px); otherwise it folds to a pill. A filter appears
// on long lists.
import { langOf, t } from '../i18n';

interface Item { id: string; text: string; depth?: number; }
interface Props {
  items: Item[];
  /** Window width from which the panel starts open. */
  openFrom?: number;
}
const { items, openFrom = 1420 } = Astro.props;
const s = t(langOf(Astro.url));
const filterable = items.length > 12;
---

{items.length > 1 && (
  <aside class="sm" data-section-menu data-open-from={openFrom} aria-label={s.onThisPage} data-pagefind-ignore>
    <div class="sm-panel" id="sm-panel" hidden>
      <div class="sm-head">
        <p class="sm-title">{s.onThisPage}</p>
        <button type="button" class="sm-fold" data-sm-close aria-label={s.sectionsHide}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
        </button>
      </div>
      {filterable && (
        <>
          <label class="sm-sr" for="sm-filter">{s.sectionsFilter}</label>
          <input id="sm-filter" class="sm-filter" type="search" placeholder={s.sectionsFilter} autocomplete="off" data-sm-filter />
          <p class="sm-none" data-sm-none hidden>{s.sectionsNone}</p>
        </>
      )}
      <nav>
        <ul class="sm-list">
          {items.map((i) => (
            <li class:list={[`d${i.depth ?? 2}`]}><a href={`#${i.id}`} data-sm-link>{i.text}</a></li>
          ))}
        </ul>
      </nav>
      <a class="sm-top" href="#top">{s.backToTop}</a>
    </div>
    <button type="button" class="sm-pill" data-sm-open aria-expanded="false" aria-controls="sm-panel">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h10M4 18h13" /></svg>
      <span class="sm-pill-l">{s.onThisPage}</span>
      <span class="sm-pill-cur" data-sm-current></span>
    </button>
  </aside>
)}

<style>
  .sm { position: fixed; z-index: 30; top: 88px; right: 16px; display: flex; flex-direction: column; align-items: flex-end; gap: 8px; }
  .sm-panel { width: 264px; max-height: calc(100vh - 120px); overflow-y: auto; background: var(--card); border: 1px solid var(--rule); border-radius: 12px; box-shadow: 0 8px 28px rgba(24, 32, 32, 0.14); padding: 10px 8px 10px; font-size: 15px; }
  .sm-panel[hidden] { display: none; }
  .sm-head { display: flex; align-items: center; justify-content: space-between; padding: 0 2px 0 10px; margin-bottom: 4px; }
  .sm-title { margin: 0; font-weight: 650; }
  .sm-fold { width: 36px; height: 36px; border: 0; border-radius: 8px; background: transparent; color: var(--ink-2); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
  .sm-fold:hover { color: var(--ink); background: var(--paper-2); }
  .sm-filter { width: calc(100% - 8px); margin: 2px 4px 8px; height: 38px; padding: 0 10px; border: 1px solid var(--rule); border-radius: 8px; background: var(--paper); color: var(--ink); font: inherit; font-size: 15px; }
  .sm-none { margin: 0 10px 6px; color: var(--ink-2); font-size: 14px; }
  .sm-list { list-style: none; margin: 0; padding: 0; }
  .sm-list a { display: block; padding: 6px 10px; border-radius: 8px; color: var(--ink-2); text-decoration: none; line-height: 1.35; box-shadow: inset 2px 0 0 transparent; }
  .sm-list .d3 a { padding-left: 22px; font-size: 14px; }
  .sm-list a:hover { color: var(--ink); background: var(--paper-2); }
  .sm-list a[aria-current='location'] { color: var(--ink); font-weight: 650; background: var(--paper-2); box-shadow: inset 2px 0 0 var(--teal); }
  .sm-top { display: block; margin: 6px 4px 0; padding: 8px 6px 0; border-top: 1px solid var(--rule); font-size: 14px; }
  .sm-pill { display: inline-flex; align-items: center; gap: 8px; max-width: min(360px, calc(100vw - 32px)); min-height: 44px; padding: 0 16px; border: 1px solid var(--rule); border-radius: 999px; background: var(--card); color: var(--ink); box-shadow: 0 8px 28px rgba(24, 32, 32, 0.14); font: inherit; font-size: 15px; font-weight: 600; cursor: pointer; }
  .sm-pill[hidden] { display: none; }
  .sm-pill-cur { font-weight: 400; color: var(--ink-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sm-pill-cur:empty { display: none; }
  .sm-pill-cur::before { content: ': '; }
  .sm-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .sm :focus-visible { outline: 3px solid var(--teal); outline-offset: 2px; }

  @media (max-width: 820px) {
    .sm { top: auto; bottom: 16px; left: 16px; flex-direction: column-reverse; }
    .sm-panel { width: 100%; max-height: 60vh; }
    .sm.has-current .sm-pill-l { display: none; }
    .sm-pill-cur::before { content: none; }
  }
  @media print { .sm { display: none; } }
</style>

<script>
  const KEY = 'barrel.sectionMenu';
  const read = () => { try { return localStorage.getItem(KEY); } catch { return null; } };
  const write = (v: string) => { try { localStorage.setItem(KEY, v); } catch { /* storage blocked */ } };

  document.querySelectorAll<HTMLElement>('[data-section-menu]').forEach((root) => {
    const panel = root.querySelector<HTMLElement>('.sm-panel')!;
    const pill = root.querySelector<HTMLButtonElement>('[data-sm-open]')!;
    const close = root.querySelector<HTMLButtonElement>('[data-sm-close]')!;
    const current = root.querySelector<HTMLElement>('[data-sm-current]')!;
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-sm-link]'));
    const openFrom = Number(root.dataset.openFrom) || 1420;
    const small = () => window.matchMedia('(max-width: 820px)').matches;

    const set = (open: boolean, remember = false) => {
      panel.hidden = !open;
      pill.hidden = open && !small();
      pill.setAttribute('aria-expanded', String(open));
      if (remember) write(open ? 'open' : 'folded');
    };
    const pref = read();
    set(!small() && window.innerWidth >= openFrom && pref !== 'folded');

    pill.addEventListener('click', () => {
      const open = panel.hidden;
      set(open, !small());
      if (open) (root.querySelector<HTMLInputElement>('[data-sm-filter]') ?? links[0])?.focus();
    });
    close.addEventListener('click', () => { set(false, true); pill.focus(); });
    panel.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && (small() || window.innerWidth < openFrom)) { set(false); pill.focus(); }
    });
    links.forEach((a) => a.addEventListener('click', () => { if (small() || window.innerWidth < openFrom) set(false); }));

    // Filter long lists by section title.
    const filter = root.querySelector<HTMLInputElement>('[data-sm-filter]');
    const none = root.querySelector<HTMLElement>('[data-sm-none]');
    filter?.addEventListener('input', () => {
      const q = filter.value.trim().toLowerCase();
      let shown = 0;
      links.forEach((a) => {
        const hit = !q || (a.textContent ?? '').toLowerCase().includes(q);
        a.parentElement!.hidden = !hit;
        if (hit) shown++;
      });
      if (none) none.hidden = shown > 0;
    });

    // Follow the section being read.
    const byId = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
    const mark = (id: string) => {
      const a = byId.get(id);
      if (!a) return;
      links.forEach((l) => l.removeAttribute('aria-current'));
      a.setAttribute('aria-current', 'location');
      current.textContent = a.textContent ?? '';
      root.classList.add('has-current');
      if (!panel.hidden && panel.scrollHeight > panel.clientHeight) a.scrollIntoView({ block: 'nearest' });
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) mark(e.target.id); });
      }, { rootMargin: '0px 0px -70% 0px' });
      byId.forEach((_, id) => { const h = document.getElementById(id); if (h) io.observe(h); });
    }
  });
</script>
