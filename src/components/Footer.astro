---
import { GITHUB, capabilities } from '../data/site';
---

<footer class="ftr">
  <div class="wrap ftr-grid">
    <div class="ftr-about">
      <a href="/" class="ftr-brand"><img src="/logo-symbol-coral.svg" alt="" width="24" height="26" /> Barrel</a>
      <p>Open source under the Apache 2.0 license. Built by Enki Bridge in Europe.</p>
    </div>
    <div>
      <p class="ftr-h">Product</p>
      {capabilities.map((c) => <a href={`/product/${c.slug}`}>{c.name}</a>)}
      <a href="/product">All libraries</a>
    </div>
    <div>
      <p class="ftr-h">Build</p>
      <a href="/docs">Documentation</a>
      <a href="/examples">Examples</a>
      <a href="/use-cases">Use cases</a>
      <a href="/llms.txt">llms.txt</a>
    </div>
    <div>
      <p class="ftr-h">Project</p>
      <a href={GITHUB}>GitHub</a>
      <a href={`${GITHUB}/blob/main/CHANGELOG.md`}>Changelog</a>
      <a href="/opensource">Open source</a>
      <a href="/commercial">Commercial support</a>
      <a href="/contact">Contact</a>
    </div>
  </div>
</footer>

<style>
  .ftr { border-top: 1px solid var(--rule); padding: 48px 0 64px; font-size: 15px; color: var(--ink-2); margin-top: auto; }
  .ftr-grid { display: grid; grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr)); gap: 32px; }
  .ftr a { display: block; color: var(--ink-2); text-decoration: none; padding: 3px 0; }
  .ftr a:hover { color: var(--ink); }
  .ftr-brand { display: flex !important; align-items: center; gap: 8px; color: var(--ink) !important; font-weight: 650; font-stretch: 112%; }
  .ftr-about p { max-width: 24em; }
  .ftr-h { color: var(--ink); font-weight: 650; margin: 0 0 6px; }
  @media (max-width: 820px) { .ftr-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } .ftr-about { grid-column: 1 / -1; } }
</style>
