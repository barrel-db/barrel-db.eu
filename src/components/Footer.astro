---
import { langOf, localize, t } from '../i18n';
import { siteFor } from '../data/i18n';
const lang = langOf(Astro.url);
const s = t(lang);
const L = (h: string) => localize(h, lang);
const { GITHUB, capabilities } = siteFor(lang);
---

<footer class="ftr">
  <div class="wrap ftr-grid">
    <div class="ftr-about">
      <a href={L('/')} class="ftr-brand"><img src="/logo-symbol-coral.svg" alt="" width="24" height="26" /> Barrel</a>
      <p>{s.footerAbout}</p>
    </div>
    <div>
      <p class="ftr-h">{s.product}</p>
      {capabilities.map((c) => <a href={L(`/product/${c.slug}`)}>{c.name}</a>)}
      <a href={L('/product')}>{s.allLibraries}</a>
    </div>
    <div>
      <p class="ftr-h">{s.footerBuild}</p>
      <a href={L('/docs')}>{s.documentation}</a>
      <a href={L('/examples')}>{s.examples}</a>
      <a href={L('/use-cases')}>{s.useCases}</a>
      <a href="/llms.txt">llms.txt</a>
    </div>
    <div>
      <p class="ftr-h">{s.footerProject}</p>
      <a href={GITHUB}>GitHub</a>
      <a href={`${GITHUB}/blob/main/CHANGELOG.md`}>{s.changelog}</a>
      <a href={L('/opensource')}>{s.openSource}</a>
      <a href={L('/commercial')}>{s.commercial}</a>
      <a href={L('/contact')}>{s.contact}</a>
    </div>
  </div>
</footer>

<style>
  .ftr { border-top: 1px solid var(--rule); padding: 48px 0 64px; font-size: 15px; color: var(--ink-2); margin-top: auto; }
  .ftr-grid { display: grid; grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr)); gap: 32px; }
  .ftr a { display: block; color: var(--ink-2); text-decoration: none; padding: 3px 0; }
  .ftr a:hover { color: var(--ink); }
  .ftr-brand { display: flex !important; align-items: center; gap: 8px; color: var(--ink) !important; font-weight: 650; font-stretch: 112%; }
  .ftr-about p { max-width: 24em; }
  .ftr-h { color: var(--ink); font-weight: 650; margin: 0 0 6px; }
  @media (max-width: 820px) { .ftr-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } .ftr-about { grid-column: 1 / -1; } }
</style>
