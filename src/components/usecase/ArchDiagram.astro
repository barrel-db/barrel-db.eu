---
// Mechanism diagram: columns of labeled boxes, with the call between each pair.
// Coral boxes hold the data (the record); plain boxes are callers and services.
import type { ArchColumn } from './types';
import { langOf } from '../../i18n';

interface Props {
  columns: ArchColumn[];
  /** One label per gap between columns: what crosses it. */
  edges?: string[];
  label: string;
}

const { columns, edges = [], label } = Astro.props;
const then = langOf(Astro.url) === 'fr' ? 'puis' : 'then';
---

<figure class="arch" aria-label={label}>
  <ol class="arch-row" style={`--cols: ${columns.length}`}>
    {columns.map((c, i) => (
      <>
        <li class="arch-col">
          <p class="arch-who">{c.who}</p>
          <ul class="arch-boxes">
            {c.boxes.map((b) => (
              <li class:list={['arch-box', { 'is-rec': b.rec }]}>
                <strong>{b.name}</strong>
                <span>{b.note}</span>
              </li>
            ))}
          </ul>
        </li>
        {i < columns.length - 1 && (
          <li class="arch-edge" aria-label={edges[i] ? (then === 'puis' ? `puis : ${edges[i]}` : `then: ${edges[i]}`) : then}>
            <span class="arch-line" aria-hidden="true"></span>
            {edges[i] && <span class="arch-edge-t">{edges[i]}</span>}
          </li>
        )}
      </>
    ))}
  </ol>
</figure>

<style>
  .arch { margin: 0; }
  .arch-row { list-style: none; margin: 0; padding: 0; display: flex; align-items: stretch; gap: 0; }
  .arch-col { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: 10px; }
  .arch-who { margin: 0; font-size: 14px; font-weight: 650; color: var(--ink-2); }
  .arch-boxes { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .arch-box { padding: 14px 16px; border-radius: 6px; border: 1.5px solid var(--ink); background: var(--card); display: flex; flex-direction: column; min-width: 0; }
  .arch-box strong { font-weight: 620; overflow-wrap: anywhere; }
  .arch-box span { font-size: 14px; color: var(--ink-2); }
  .arch-box.is-rec { background: var(--coral); border-color: var(--coral); color: var(--on-coral); }
  .arch-box.is-rec span { color: var(--on-coral); opacity: 0.9; }
  .arch-edge { flex: 0 0 112px; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 6px; padding: 32px 8px 0; text-align: center; }
  .arch-line { display: block; width: 100%; border-top: 1.5px solid var(--teal); position: relative; }
  .arch-line::after { content: ''; position: absolute; right: -1px; top: -5px; border: 4px solid transparent; border-left: 7px solid var(--teal); border-right: 0; }
  .arch-edge-t { font-size: 13px; line-height: 1.35; color: var(--teal); overflow-wrap: anywhere; }
  @media (max-width: 820px) {
    .arch-row { flex-direction: column; }
    .arch-edge { flex: none; flex-direction: row; justify-content: flex-start; padding: 8px 0 8px 24px; }
    .arch-line { width: 0; height: 28px; border-top: 0; border-left: 1.5px solid var(--teal); }
    .arch-line::after { right: auto; left: -5px; top: auto; bottom: -1px; border: 4px solid transparent; border-top: 7px solid var(--teal); border-bottom: 0; }
    .arch-edge-t { text-align: left; }
  }
</style>
