---
// One use case page: problem, mechanism, numbered build steps, the split of
// work between Barrel and your application, limits, and where to go next.
import Base from '../../layouts/Base.astro';
import CodeBlock from '../CodeBlock.astro';
import CodeTabs from '../CodeTabs.astro';
import ArchDiagram from './ArchDiagram.astro';
import { siteFor } from '../../data/i18n';
import { langOf, localize } from '../../i18n';
import { fmt } from './types';
import type { ArchColumn, Step, GoLink } from './types';

interface Props {
  title: string;
  lead: string;
  sub: string;
  problem: string;
  arch: ArchColumn[];
  edges?: string[];
  archNote: string;
  stepsIntro: string;
  steps: Step[];
  barrel: string[];
  app: string[];
  limits: string[];
  links: GoLink[];
}

const p = Astro.props;
const lang = langOf(Astro.url);
const { statusLabel } = siteFor(lang);
const L = {
  en: { crumbs: 'Breadcrumb', useCases: 'Use cases', problem: 'The problem', fit: 'How it fits together',
        figure: (t: string) => `How ${t.toLowerCase()} fits together`, build: 'Build it', output: 'Output',
        barrel: 'What Barrel does', app: 'What your application does', limits: 'Limits', go: 'Go further' },
  fr: { crumbs: 'Fil d’Ariane', useCases: 'Cas d’usage', problem: 'Le problème', fit: 'Comment les pièces s’assemblent',
        figure: (t: string) => `Schéma : ${t}`, build: 'Le construire', output: 'Sortie',
        barrel: 'Ce que fait Barrel', app: 'Ce que fait votre application', limits: 'Limites', go: 'Aller plus loin' },
}[lang];
---

<Base title={p.title} description={p.lead}>
  <div class="ua">
    <nav aria-label={L.crumbs} class="ua-crumb small"><a href={localize('/use-cases', lang)}>{L.useCases}</a> / <span aria-current="page">{p.title}</span></nav>
    <h1 class="ua-h1">{p.title}</h1>
    <p class="lead ua-lead">{p.lead}</p>
    <p class="muted ua-sub" set:html={fmt(p.sub)} />

    <section class="ua-sec" aria-labelledby="problem">
      <h2 id="problem" class="ua-h2">{L.problem}</h2>
      <p class="ua-p">{p.problem}</p>
    </section>

    <section class="ua-sec" aria-labelledby="fit">
      <h2 id="fit" class="ua-h2">{L.fit}</h2>
      <ArchDiagram columns={p.arch} edges={p.edges} label={L.figure(p.title)} />
      <p class="small muted ua-note" set:html={fmt(p.archNote)} />
      <slot name="after-arch" />
    </section>

    <section class="ua-sec" aria-labelledby="build">
      <h2 id="build" class="ua-h2">{L.build}</h2>
      <p class="muted ua-p" set:html={fmt(p.stepsIntro)} />
      <ol class="ua-steps">
        {p.steps.map((s) => (
          <li class="ua-step">
            <div class="ua-step-h">
              <h3 class="ua-h3">{s.title}</h3>
              {s.status && s.status !== 'today' && <span class={`mark mark--${s.status}`}>{statusLabel[s.status]}</span>}
            </div>
            <p class="muted ua-p" set:html={fmt(s.body)} />
            {s.tabs && <CodeTabs tabs={s.tabs} />}
            {s.code && <CodeBlock code={s.code} lang={s.lang} label={s.label} />}
            {s.out && <CodeBlock code={s.out} label={s.outLabel ?? L.output} output />}
          </li>
        ))}
      </ol>
    </section>

    <section class="ua-sec ua-split">
      <div>
        <h2 class="ua-h2 ua-h2--s">{L.barrel}</h2>
        <ul class="ua-list">{p.barrel.map((t) => <li set:html={fmt(t)} />)}</ul>
      </div>
      <div>
        <h2 class="ua-h2 ua-h2--s">{L.app}</h2>
        <ul class="ua-list">{p.app.map((t) => <li set:html={fmt(t)} />)}</ul>
      </div>
    </section>

    <section class="ua-sec" aria-labelledby="limits">
      <h2 id="limits" class="ua-h2">{L.limits}</h2>
      <ul class="ua-list ua-limits">{p.limits.map((t) => <li set:html={fmt(t)} />)}</ul>
    </section>

    <section class="ua-go" aria-labelledby="go">
      <h2 id="go" class="ua-h3">{L.go}</h2>
      <ul class="ua-links">{p.links.map((l) => <li><a href={localize(l.href, lang)}>{l.label}</a></li>)}</ul>
    </section>
  </div>
</Base>

<style>
  .ua { max-width: 1040px; margin: 0 auto; padding: 40px var(--gutter) 96px; }
  .ua-crumb { color: var(--ink-2); margin: 0 0 24px; }
  .ua-crumb a { color: var(--ink-2); }
  .ua-h1 { margin: 0 0 20px; font-size: clamp(2.5rem, 6vw, 3.75rem); font-weight: 620; font-stretch: 112%; letter-spacing: -0.03em; line-height: 1; }
  .ua-lead { margin: 0 0 16px; }
  .ua-sub { margin: 0 0 48px; max-width: 40em; }
  .ua-sec { margin: 0 0 64px; }
  .ua-h2 { margin: 0 0 16px; font-size: var(--step-2); font-stretch: 108%; }
  .ua-h2--s { font-size: 24px; margin-bottom: 12px; }
  .ua-h3 { margin: 0; font-size: var(--step-1); font-weight: 620; }
  .ua-p { margin: 0 0 16px; max-width: 42em; }
  .ua-note { margin: 16px 0 0; max-width: 44em; }
  .ua-steps { list-style: none; margin: 32px 0 0; padding: 0; counter-reset: step; }
  .ua-step { counter-increment: step; position: relative; padding-left: 48px; margin: 0 0 40px; min-width: 0; }
  .ua-step::before { content: counter(step); position: absolute; left: 0; top: -2px; font-stretch: 112%; font-weight: 620; font-size: 28px; line-height: 1; color: var(--teal); }
  .ua-step-h { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 16px; margin: 0 0 4px; }
  .ua-split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px; }
  .ua-list { margin: 0; padding-left: 20px; max-width: 42em; }
  .ua-list li { margin-bottom: 8px; }
  .ua-go { border-top: 1px solid var(--rule); padding-top: 24px; }
  .ua-go .ua-h3 { margin-bottom: 12px; }
  .ua-links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 32px; }
  @media (max-width: 820px) {
    .ua { padding-top: 24px; }
    .ua-split { grid-template-columns: minmax(0, 1fr); }
    .ua-step { padding-left: 0; }
    .ua-step::before { position: static; display: block; margin-bottom: 6px; }
  }
</style>
