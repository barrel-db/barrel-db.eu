---
// A support assistant, step by step: Barrel finds what is relevant, a separate AI model
// writes the answer, and Barrel stores a new memory that the next question can find.
// Deterministic demonstration: the matches are written in advance, nothing is scored.
import { langOf } from '../../i18n';
const lang = langOf(Astro.url);
const S = {
  en: {
    who: 'Northwind support assistant',
    whoNote: 'talking with Marie, a customer',
    reset: 'Start over',
    ask: 'Marie asks',
    pick: 'Pick a question',
    find: 'Barrel finds',
    findNote: 'Searches the help articles and what it remembers about Marie, by meaning and by words.',
    answer: 'The AI model answers',
    answerNote: 'A separate language model writes the reply from what Barrel found. Barrel does not write text.',
    remember: 'Barrel remembers',
    rememberNote: 'After each conversation the application stores a short note. The next question can find it.',
    foot: 'A demonstration in your browser with a small set of articles. Real applications choose their own AI model; Barrel stores, searches and keeps the history.',
    // Scenario, used by the script.
    empty: 'Pick a question to see what Barrel finds.',
    emptyReply: 'The answer appears here.',
    articles: {
      reset: 'Help article: After five failed sign-ins an account locks for 30 minutes. A reset link unlocks it at once.',
      sso: 'Help article: Accounts that sign in with the company login (SSO) are unlocked by the company administrator.',
      invoice: 'Help article: Billing admins export invoices as CSV from the Reports tab.',
    },
    startMem: 'Marie works at Acme, on the Team plan. Her company signs in with SSO.',
    needle: 'locked out',
    kMemMarie: 'Memory about Marie',
    kMemEarlier: 'Memory from the earlier conversation',
    kLocked: 'Matches the meaning of "locked out"',
    kMeaning: 'Matches the meaning',
    kInvoices: 'Matches the words "invoices"',
    qLocked: 'I am locked out of my account.',
    rLocked: 'Your company signs in with SSO, so your administrator at Acme can unlock your account. If you also use a password, a reset link unlocks it right away.',
    nLocked: 'Nov 8: Marie was locked out. Told her to ask her Acme administrator (SSO).',
    qAgain: 'It happened again today, what should I do?',
    rAgain: 'This is the second lockout since your last message. Your Acme administrator can unlock it; if it keeps happening, they can check the SSO settings with us.',
    rAgainNoMem: 'Without anything remembered about an earlier problem, the assistant can only repeat the general steps: a reset link unlocks the account.',
    nAgain: 'Nov 9: Marie locked out a second time. Suggested an SSO check with her administrator.',
    qInvoice: 'Where do I find our invoices?',
    rInvoice: 'Billing admins at Acme can export invoices as CSV from the Reports tab.',
    nInvoice: 'Nov 9: Marie asked where invoices are. Pointed to the Reports tab.',
  },
  fr: {
    who: 'Assistant du support Northwind',
    whoNote: 'en conversation avec Marie, une cliente',
    reset: 'Recommencer',
    ask: 'Marie demande',
    pick: 'Choisissez une question',
    find: 'Barrel trouve',
    findNote: 'Cherche dans les articles d’aide et dans ce qu’il a retenu sur Marie, par le sens et par les mots.',
    answer: 'Le modèle d’IA répond',
    answerNote: 'Un modèle de langage distinct rédige la réponse à partir de ce que Barrel a trouvé. Barrel n’écrit pas de texte.',
    remember: 'Barrel retient',
    rememberNote: 'Après chaque conversation, l’application enregistre une courte note. La question suivante peut la retrouver.',
    foot: 'Une démonstration dans votre navigateur, avec quelques articles. Les vraies applications choisissent leur propre modèle d’IA ; Barrel stocke, cherche et garde l’historique.',
    empty: 'Choisissez une question pour voir ce que Barrel trouve.',
    emptyReply: 'La réponse apparaît ici.',
    articles: {
      reset: 'Article d’aide : après cinq échecs de connexion, un compte est bloqué pendant 30 minutes. Un lien de réinitialisation le débloque aussitôt.',
      sso: 'Article d’aide : les comptes qui se connectent avec l’identifiant de l’entreprise (SSO) sont débloqués par l’administrateur de l’entreprise.',
      invoice: 'Article d’aide : les administrateurs de facturation exportent les factures en CSV depuis l’onglet Rapports.',
    },
    startMem: 'Marie travaille chez Acme, sur l’offre Team. Son entreprise se connecte en SSO.',
    needle: 'bloquée',
    kMemMarie: 'Souvenir sur Marie',
    kMemEarlier: 'Souvenir de la conversation précédente',
    kLocked: 'Proche du sens de « compte bloqué »',
    kMeaning: 'Proche du sens',
    kInvoices: 'Contient le mot « factures »',
    qLocked: 'Mon compte est bloqué.',
    rLocked: 'Votre entreprise se connecte en SSO : votre administrateur chez Acme peut débloquer votre compte. Si vous utilisez aussi un mot de passe, un lien de réinitialisation le débloque tout de suite.',
    nLocked: '8 nov. : Marie était bloquée. Je lui ai conseillé de contacter son administrateur Acme (SSO).',
    qAgain: 'C’est encore arrivé aujourd’hui, que dois-je faire ?',
    rAgain: 'C’est le deuxième blocage depuis votre dernier message. Votre administrateur Acme peut débloquer le compte ; si cela se reproduit, il peut vérifier les réglages SSO avec nous.',
    rAgainNoMem: 'Sans souvenir d’un problème précédent, l’assistant ne peut que répéter la marche à suivre générale : un lien de réinitialisation débloque le compte.',
    nAgain: '9 nov. : Marie bloquée une deuxième fois. Proposé une vérification SSO avec son administrateur.',
    qInvoice: 'Où trouver nos factures ?',
    rInvoice: 'Chez Acme, les administrateurs de facturation peuvent exporter les factures en CSV depuis l’onglet Rapports.',
    nInvoice: '9 nov. : Marie a demandé où sont les factures. Orientée vers l’onglet Rapports.',
  },
}[lang];
---

<div class="ad" data-assistant data-strings={JSON.stringify(S)}>
  <div class="ad-head">
    <p class="ad-who"><strong>{S.who}</strong> <span class="muted small">{S.whoNote}</span></p>
    <button type="button" class="button button--small" data-ad-reset>{S.reset}</button>
  </div>

  <div class="ad-cols">
    <section class="ad-col" aria-labelledby="ad-ask">
      <h3 id="ad-ask" class="ad-h"><span class="ad-n">1</span> {S.ask}</h3>
      <div class="ad-qs" role="group" aria-label={S.pick} data-ad-qs></div>
    </section>

    <section class="ad-col ad-barrel" aria-labelledby="ad-find">
      <h3 id="ad-find" class="ad-h"><span class="ad-n">2</span> {S.find}</h3>
      <p class="small muted ad-note">{S.findNote}</p>
      <ul class="ad-found" data-ad-found aria-live="polite"></ul>
    </section>

    <section class="ad-col" aria-labelledby="ad-answer">
      <h3 id="ad-answer" class="ad-h"><span class="ad-n">3</span> {S.answer}</h3>
      <p class="small muted ad-note">{S.answerNote}</p>
      <p class="ad-reply" data-ad-reply aria-live="polite"></p>
    </section>
  </div>

  <section class="ad-memory" aria-labelledby="ad-mem">
    <h3 id="ad-mem" class="ad-h"><span class="ad-n">4</span> {S.remember}</h3>
    <p class="small muted ad-note">{S.rememberNote}</p>
    <ul class="ad-mems" data-ad-mems aria-live="polite"></ul>
  </section>
  <p class="small muted ad-foot">{S.foot}</p>
</div>

<style>
  .ad { border: 1px solid var(--rule); border-radius: 12px; padding: 28px; background: var(--card); }
  .ad-head { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; margin-bottom: 20px; }
  .ad-who { margin: 0; }
  .ad-cols { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) minmax(0, 1.2fr); gap: 20px; }
  .ad-col { min-width: 0; }
  .ad-h { display: flex; align-items: center; gap: 10px; font-size: 17px; margin: 0 0 6px; }
  .ad-n { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 13px; background: var(--paper-2); font-size: 14px; }
  .ad-barrel .ad-n, .ad-memory .ad-n { background: var(--coral); color: var(--on-coral); }
  .ad-note { margin: 0 0 12px; }
  .ad-qs { display: flex; flex-direction: column; gap: 8px; }
  .ad-qs :global(button) { text-align: left; padding: 10px 12px; border-radius: var(--radius); border: 1.5px solid var(--rule); background: var(--paper); color: var(--ink); font: inherit; font-size: 15px; cursor: pointer; }
  .ad-qs :global(button[aria-pressed='true']) { border-color: var(--ink); background: var(--paper-2); font-weight: 600; }
  .ad-found, .ad-mems { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .ad-found :global(li), .ad-mems :global(li) { padding: 10px 12px; border-radius: var(--radius); background: var(--paper); border: 1px solid var(--rule); font-size: 15px; }
  .ad-found :global(.k) { display: block; font-size: 12px; color: var(--ink-2); margin-bottom: 2px; }
  .ad-found :global(li.is-mem) { border-color: var(--coral); }
  .ad-mems :global(li.is-new) { border-color: var(--coral); }
  .ad-reply { margin: 0; padding: 12px 14px; border-radius: var(--radius); background: var(--paper-2); min-height: 6em; }
  .ad-memory { margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--rule); }
  .ad-foot { margin: 16px 0 0; }
  .ad :global(.empty) { color: var(--ink-2); font-style: italic; }
  @media (max-width: 900px) { .ad { padding: 18px; } .ad-cols { grid-template-columns: minmax(0, 1fr); } }
</style>

<script>
  type Item = { kind: string; text: string; mem?: boolean };
  type Q = { id: string; q: string; finds: () => Item[]; reply: () => string; note: string };

  document.querySelectorAll<HTMLElement>('[data-assistant]').forEach((root) => {
    const T = JSON.parse(root.dataset.strings!);
    const ARTICLES: Record<'reset' | 'sso' | 'invoice', string> = T.articles;
    const START_MEM: string = T.startMem;
    let memories: string[] = [];
    let asked = new Set<string>();
    let current = '';

    const remembers = (needle: string) => memories.find((m) => m.includes(needle));

    const QUESTIONS: Q[] = [
      {
        id: 'locked', q: T.qLocked,
        finds: () => [
          { kind: T.kMemMarie, text: START_MEM, mem: true },
          { kind: T.kLocked, text: ARTICLES.sso },
          { kind: T.kLocked, text: ARTICLES.reset },
        ],
        reply: () => T.rLocked,
        note: T.nLocked,
      },
      {
        id: 'again', q: T.qAgain,
        finds: () => {
          const m = remembers(T.needle);
          return m
            ? [
                { kind: T.kMemEarlier, text: m, mem: true },
                { kind: T.kMemMarie, text: START_MEM, mem: true },
                { kind: T.kMeaning, text: ARTICLES.sso },
              ]
            : [
                { kind: T.kMemMarie, text: START_MEM, mem: true },
                { kind: T.kMeaning, text: ARTICLES.reset },
              ];
        },
        reply: () => (remembers(T.needle) ? T.rAgain : T.rAgainNoMem),
        note: T.nAgain,
      },
      {
        id: 'invoice', q: T.qInvoice,
        finds: () => [
          { kind: T.kMemMarie, text: START_MEM, mem: true },
          { kind: T.kInvoices, text: ARTICLES.invoice },
        ],
        reply: () => T.rInvoice,
        note: T.nInvoice,
      },
    ];

    const qBox = root.querySelector<HTMLElement>('[data-ad-qs]')!;
    const found = root.querySelector<HTMLElement>('[data-ad-found]')!;
    const reply = root.querySelector<HTMLElement>('[data-ad-reply]')!;
    const mems = root.querySelector<HTMLElement>('[data-ad-mems]')!;

    function li(text: string, cls = '', kind = '') {
      const e = document.createElement('li');
      if (cls) e.className = cls;
      if (kind) { const k = document.createElement('span'); k.className = 'k'; k.textContent = kind; e.append(k); }
      e.append(document.createTextNode(text));
      return e;
    }

    function draw(newNote = '') {
      qBox.replaceChildren(...QUESTIONS.map((q) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = q.q;
        b.setAttribute('aria-pressed', String(current === q.id));
        b.addEventListener('click', () => ask(q));
        return b;
      }));
      const q = QUESTIONS.find((x) => x.id === current);
      if (!q) {
        found.replaceChildren(li(T.empty, 'empty'));
        reply.textContent = '';
        const e = document.createElement('span'); e.className = 'empty'; e.textContent = T.emptyReply; reply.append(e);
      } else {
        found.replaceChildren(...q.finds().map((i) => li(i.text, i.mem ? 'is-mem' : '', i.kind)));
        reply.textContent = q.reply();
      }
      mems.replaceChildren(...[START_MEM, ...memories].map((m) => li(m, m === newNote ? 'is-new' : '')));
    }

    function ask(q: Q) {
      current = q.id;
      // The answer uses what was remembered before this question; the note is stored after.
      draw();
      if (!asked.has(q.id)) {
        asked.add(q.id);
        memories = [...memories, q.note];
        mems.replaceChildren(...[START_MEM, ...memories].map((m) => li(m, m === q.note ? 'is-new' : '')));
      }
    }

    root.querySelector('[data-ad-reset]')!.addEventListener('click', () => { memories = []; asked = new Set(); current = ''; draw(); });
    draw();
  });
</script>
