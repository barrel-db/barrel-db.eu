%% Data under ./data, logs on stderr so stdout is the example output.
%% barrel_spaces reopens a record-mode space with this embedder.
[{barrel_docdb, [{data_dir, "data/docdb"}]},
 {barrel_spaces, [{embedder, {hash_embed, #{}}}]},
 {kernel, [{logger_level, warning},
           {logger, [{handler, default, logger_std_h,
                      #{config => #{type => standard_error}}}]}]}].
