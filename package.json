{
  "name": "barrel-db-eu",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "sync": "node scripts/sync-guides.mjs",
    "build:docs": "bash scripts/build-docs.sh",
    "build": "bash scripts/build-docs.sh && node scripts/sync-guides.mjs && astro build && pagefind --site dist",
    "build:site": "node scripts/sync-guides.mjs && astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "check:site": "node scripts/check-site.mjs",
    "verify:examples": "bash scripts/verify-examples.sh",
    "astro": "astro",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/fragment-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^5.17.1",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "linkinator": "^8.1.0",
    "pagefind": "^1.5.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.6"
  }
}
